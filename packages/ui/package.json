{
  "name": "@shadoworg/shadowui",
  "version": "0.0.4",
  "sideEffects": false,
  "license": "MIT",
  "description": "SHADOWUI - A modern React component library",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwind"
  ],
  "author": "Daffa Aditya <daffaaditya.me@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaffaAdityaDev/shadowUI"
  },
  "homepage": "https://github.com/DaffaAdityaDev/shadowUI",
  "bugs": {
    "url": "https://github.com/DaffaAdityaDev/shadowUI/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/Button/button.d.ts",
      "import": "./dist/components/Button/button.mjs",
      "require": "./dist/components/Button/button.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rimraf .turbo node_modules dist",
    "prepublishOnly": "pnpm build",
    "version:patch": "npm version patch --no-git-tag-version",
    "pack": "npm pack",
    "publish:script": "pnpm build && npm publish --access public"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.2",
    "typescript": "5.5.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "tailwind-merge": "^1.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}