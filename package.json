{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "concurrently -n \"UI,Frontend\" -c \"blue,green\" \"pnpm --filter @shadoworg/shadowui dev\" \"pnpm -C frontend dev\"",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish",
    "preview-storybook": "turbo run preview-storybook",
    "publish:ui": "pnpm --filter @shadoworg/shadowui run publish:script"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "prettier": "^3.2.5",
    "turbo": "^2.6.1"
  },
  "packageManager": "pnpm@10.22.0",
  "name": "design-system",
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
